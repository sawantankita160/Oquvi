# Supabase Configuration for Oquvi
# 
# Instructions:
# 1. Ensure a file named .env exists in the project root:
# 2. In your Supabase Dashboard (https://supabase.com/dashboard):
#    - Open your project: Settings (gear icon) -> API
#    - Project URL: Copy and set as VITE_SUPABASE_URL
#    - Project API Keys: Copy the "anon" / "Publishable" key (starts with "eyJ..." or "sb_publishable_...")
#      and set as VITE_SUPABASE_ANON_KEY (or VITE_SUPABASE_PUBLISHABLE_KEY)
# 3. SECURITY WARNING:
#    - Never put your secret/service_role key in this frontend file.
#    - Frontend only uses the Publishable / Anon public key.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
